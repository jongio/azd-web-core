import Trophy from "@lucide/astro/icons/trophy";
import User from "@lucide/astro/icons/user";
import Webhook from "@lucide/astro/icons/webhook";
import Wrench from "@lucide/astro/icons/wrench";
import Zap from "@lucide/astro/icons/zap";

/**
 * Lucide's own `AstroComponent` type lives at `@lucide/astro/types`, which the
 * package does not list in its `exports` map, so it cannot be imported. Naming
 * the shape locally is what keeps the inferred type of `icons` portable into the
 * published output (otherwise ts2883: the inferred type would reference a
 * node_modules-relative path).
 *
 * `satisfies` rather than a type annotation, so the literal keys survive and
 * `IconName` stays a union of the actual icon names. A `Record<string, ...>`
 * annotation would typecheck but silently give up compile-time name validation,
 * which is the main reason this registry exists.
 */
type IconGlyph = (props: Record<string, unknown>) => unknown;

/**
 * The approved icon vocabulary, written out explicitly.
 *
 * This union is the source of truth rather than `keyof typeof icons` because the
 * map's inferred value type is Lucide's `AstroComponent`, which lives behind a
 * subpath the package does not export. Anything that leaks that inferred type
 * into the public surface fails as non-portable (ts2883). Declaring the names
 * here and annotating the map below keeps full compile-time name checking while
 * staying publishable.
 *
 * Adding an icon means: add the import, add the name here, add the map entry.
 * Miss any of the three and the build fails, which is the intent.
 */
export type IconName =
  | "accessibility"
  | "archive"
  | "atom"
  | "blocks"
  | "book"
  | "book-marked"
  | "book-open"
  | "bot"
  | "brain"
  | "brush"
  | "bug"
  | "chart-column"
  | "check"
  | "circle-check"
  | "circle-x"
  | "clipboard-list"
  | "clock"
  | "cloud"
  | "code"
  | "container"
  | "database"
  | "dollar-sign"
  | "drama"
  | "eye"
  | "file-code"
  | "file-pen"
  | "file-text"
  | "flask-conical"
  | "folder"
  | "folder-tree"
  | "gem"
  | "globe"
  | "graduation-cap"
  | "hammer"
  | "heart"
  | "heart-pulse"
  | "life-buoy"
  | "lightbulb"
  | "link"
  | "list"
  | "lock"
  | "lock-keyhole"
  | "map-pin"
  | "megaphone"
  | "message-circle"
  | "monitor"
  | "mouse-pointer-click"
  | "package"
  | "party-popper"
  | "play"
  | "plug"
  | "refresh-cw"
  | "repeat"
  | "rocket"
  | "ruler"
  | "satellite-dish"
  | "save"
  | "search"
  | "server"
  | "settings"
  | "shield"
  | "sparkles"
  | "square"
  | "star"
  | "stethoscope"
  | "tag"
  | "target"
  | "tent"
  | "terminal"
  | "triangle-alert"
  | "trophy"
  | "user"
  | "webhook"
  | "wrench"
  | "zap";

const icons: Record<IconName, IconGlyph> = {
  accessibility: Accessibility,
  archive: Archive,
  atom: Atom,
  blocks: Blocks,
  book: Book,
  "book-marked": BookMarked,
  "book-open": BookOpen,
  bot: Bot,
  brain: Brain,
  brush: Brush,
  bug: Bug,
  "chart-column": ChartColumn,
  check: Check,
  "circle-check": CircleCheck,
  "circle-x": CircleX,
  "clipboard-list": ClipboardList,
  clock: Clock,
  cloud: Cloud,
  code: Code,
  container: Container,
  database: Database,
  "dollar-sign": DollarSign,
  drama: Drama,
  eye: Eye,
  "file-code": FileCode,
  "file-pen": FilePen,
  "file-text": FileText,
  "flask-conical": FlaskConical,
  folder: Folder,
  "folder-tree": FolderTree,
  gem: Gem,
  globe: Globe,
  "graduation-cap": GraduationCap,
  hammer: Hammer,
  heart: Heart,
  "heart-pulse": HeartPulse,
  "life-buoy": LifeBuoy,
  lightbulb: Lightbulb,
  link: Link,
  list: List,
  lock: Lock,
  "lock-keyhole": LockKeyhole,
  "map-pin": MapPin,
  megaphone: Megaphone,
  "message-circle": MessageCircle,
  monitor: Monitor,
  "mouse-pointer-click": MousePointerClick,
  package: Package,
  "party-popper": PartyPopper,
  play: Play,
  plug: Plug,
  "refresh-cw": RefreshCw,
  repeat: Repeat,
  rocket: Rocket,
  ruler: Ruler,
  "satellite-dish": SatelliteDish,
  save: Save,
  search: Search,
  server: Server,
  settings: Settings,
  shield: Shield,
  sparkles: Sparkles,
  square: Square,
  star: Star,
  stethoscope: Stethoscope,
  tag: Tag,
  target: Target,
  tent: Tent,
  terminal: Terminal,
  "triangle-alert": TriangleAlert,
  trophy: Trophy,
  user: User,
  webhook: Webhook,
  wrench: Wrench,
  zap: Zap,
};

export interface Props {
  /** Registry key. See `icons` above for the approved vocabulary. */
  name: IconName;
  /** Rendered width and height in px. Defaults to 20 to sit on a text baseline. */
  size?: number;
  /** Extra classes merged onto the generated <svg>. */
  class?: string;
  /**
   * Accessible label. Omit for decorative icons that sit beside visible text,
   * which is the common case: the icon then renders aria-hidden so screen
   * readers announce the adjacent text once instead of twice.
   */
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props as Props;

const Glyph = icons[name];

if (!Glyph) {
  throw new Error(
    `<Icon name="${name}" /> is not in the azd-web-core icon registry. ` +
      `Add it to src/components/Icon.astro or use one of: ${Object.keys(icons).join(", ")}`,
  );
}

const a11y = label
  ? ({ role: "img", "aria-label": label } as const)
  : ({ "aria-hidden": "true" } as const);
---

<Glyph size={size} class:list={["azd-icon", className]} {...a11y} />

<style>
  .azd-icon {
    display: inline-block;
    vertical-align: -0.125em;
    flex-shrink: 0;
  }
</style>
