import Rocket from "@lucide/astro/icons/rocket";
import Ruler from "@lucide/astro/icons/ruler";
import SatelliteDish from "@lucide/astro/icons/satellite-dish";
import Save from "@lucide/astro/icons/save";
import Search from "@lucide/astro/icons/search";
import Server from "@lucide/astro/icons/server";
import Settings from "@lucide/astro/icons/settings";
import Shield from "@lucide/astro/icons/shield";
import Sparkles from "@lucide/astro/icons/sparkles";
import Square from "@lucide/astro/icons/square";
import Star from "@lucide/astro/icons/star";
import Stethoscope from "@lucide/astro/icons/stethoscope";
import Tag from "@lucide/astro/icons/tag";
import Target from "@lucide/astro/icons/target";
import Tent from "@lucide/astro/icons/tent";
import Terminal from "@lucide/astro/icons/terminal";
