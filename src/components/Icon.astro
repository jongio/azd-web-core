---
/**
 * Shared icon component backed by Lucide.
 *
 * Exists so sites can render an icon from a *string* name. Data files across the
 * consuming sites (agents.ts, extensions.ts, tour steps) store their icon as a
 * serializable field, so they cannot hold an imported Astro component. Importing
 * every Lucide icon individually at each call site would also scatter the icon
 * vocabulary across four repos, which is exactly the design drift this package
 * exists to prevent.
 *
 * The registry below is the single approved icon vocabulary. Adding an icon is a
 * deliberate one-line change here rather than an ad-hoc import in a site.
 *
 * Unknown names fail loudly at build time instead of rendering an empty box,
 * because a silently missing icon is the same class of defect as the emoji this
 * component replaces: it looks fine to the author and broken to the visitor.
 */
import Accessibility from "@lucide/astro/icons/accessibility";
import Archive from "@lucide/astro/icons/archive";
import Atom from "@lucide/astro/icons/atom";
import Blocks from "@lucide/astro/icons/blocks";
