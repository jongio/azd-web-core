---
import NavLinks from "./NavLinks.astro";
import type { NavLink } from "./NavLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SocialLinks from "./SocialLinks.astro";
import MobileMenu from "./MobileMenu.astro";

export interface Props {
  extensionName: string;
  navLinks: NavLink[];
  githubUrl: string;
  hubUrl: string;
}

const { extensionName, navLinks, githubUrl, hubUrl } = Astro.props;
---

<header
  class="sticky top-0 z-50 border-b"
  style="border-color: var(--color-border); background-color: var(--color-surface);"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-[var(--space-6)] py-[var(--space-3)]">
    <!-- Logo / Name -->
    <div class="flex items-center gap-[var(--space-3)]">
      <a href={import.meta.env.BASE_URL} class="flex items-center gap-[var(--space-2)] hover:no-underline">
        <svg
          aria-hidden="true"
          class="h-5 w-5"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="color: var(--color-primary);"
        >
          <polyline points="4 17 10 11 4 5" />
          <line x1="12" y1="19" x2="20" y2="19" />
        </svg>
        <span class="text-base font-semibold" style="color: var(--color-text);">
          {extensionName}
        </span>
      </a>
    </div>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-[var(--space-6)] md:flex" aria-label="Main navigation">
      <NavLinks links={navLinks} />
      <a
        href={hubUrl}
        class="nav-link text-sm transition-colors hover:no-underline"
      >
        Hub
      </a>
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden items-center gap-[var(--space-3)] md:flex">
      <ThemeToggle />
      <SocialLinks githubUrl={githubUrl} variant="desktop" />
    </div>

    <!-- Mobile Menu Button -->
    <button
      class="flex h-11 w-11 items-center justify-center rounded-[var(--radius-md)] md:hidden"
      style="color: var(--color-text-muted);"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="azd-core-mobile-menu"
      data-mobile-toggle
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <MobileMenu navLinks={navLinks} githubUrl={githubUrl} />
</header>

<script>
  import { initMobileMenu } from "../utils/mobileMenu";

  let controller: AbortController | null = null;

  function setup() {
    controller?.abort();
    controller = initMobileMenu(document);
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
<style>
  .nav-link {
    color: var(--color-text-muted);
  }
  .nav-link:hover {
    color: var(--color-text);
  }
</style>