---
import { author, social } from "../config.ts";
/** Shared HTML document shell with theme initialization, fonts, favicon, and meta tags. */
export interface Props {
  title: string;
  description?: string;
  extensionName: string;
  canonicalUrl?: string;
  ogImage?: string;
  publishedDate?: string;
}

const {
  title,
  description = "An azd extension",
  extensionName: _extensionName,
  canonicalUrl,
  ogImage,
  publishedDate,
} = Astro.props;
void _extensionName; // Required prop for downstream components (part of public API)

---

<!doctype html>
<html lang="en" data-theme="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta property="article:author" content={social.linkedin} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {publishedDate && <meta property="article:modified_time" content={publishedDate} />}    <meta name="author" content={author.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content={author.twitter} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Geist fonts via Google Fonts CDN (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Geist+Mono:wght@400;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Geist+Mono:wght@400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Geist+Mono:wght@400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <slot name="head" />

    <!-- Theme init (runs before paint to prevent flash) -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("azd-theme"); } catch (e) { /* storage unavailable */ }
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = (stored === "dark" || stored === "light") ? stored : (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#0a0a0f" : "#fafafa");
        // Values sourced from --color-theme-meta in tokens.css (inline script cannot read CSS vars before paint)
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="fixed left-[var(--space-2)] top-[var(--space-2)] z-[100] -translate-y-16 rounded-[var(--radius-md)] px-[var(--space-4)] py-[var(--space-2)] text-sm font-semibold transition-transform focus:translate-y-0"
      style="background-color: var(--color-primary); color: #ffffff;"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
