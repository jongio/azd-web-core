{
  "name": "@jongio/azd-web-core",
  "version": "2.4.1",
  "description": "Shared Astro components, design tokens, and Tailwind preset for azd extension websites",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./components/*": "./src/components/*",
    "./utils/clipboard": "./src/utils/clipboard.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "astro check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "astro": "^7.0.4",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jongio/azd-web-core.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
