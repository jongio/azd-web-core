{
  "name": "@jongio/azd-web-core",
  "version": "3.0.1",
  "description": "Shared Astro components, design tokens, and Tailwind preset for azd extension websites",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./components/*": "./src/components/*",
    "./utils/clipboard": "./src/utils/clipboard.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "check": "astro check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "astro": "^7.1.6",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jongio/azd-web-core.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@lucide/astro": "^1.27.0"
  }
}
